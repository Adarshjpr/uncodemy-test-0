      transition: border-color .2s ease, transform .2s ease;
    }
    .pagenav a:hover { border-color: var(--orange); transform: translateY(-2px); }
    .pagenav .dir {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--gray);
      font-weight: 700;
      margin-bottom: 4px;
    }
    .pagenav .label { font-size: 14.5px; font-weight: 600; color: var(--dark); }
    .pagenav .next { text-align: right; }
    .pagenav .disabled { opacity: .35; pointer-events: none; }

    /* CTA */
    .cta-box {
      margin-top: 44px;
      background: linear-gradient(135deg, var(--orange), var(--orange-dark));
      border-radius: 16px;
      padding: 34px clamp(20px, 5vw, 44px);
      color: #fff;
      text-align: center;
    }
    .cta-box h3 {
      font-size: 22px;
      margin: 0 0 8px;
      color: #fff;
    }
    .cta-box p {
      margin: 0 0 20px;
      color: #FFE4DA;
      font-size: 15px;
    }
    .cta-box a {
      display: inline-block;
      background: #fff;
      color: var(--orange-dark);
      text-decoration: none;
      font-weight: 700;
      padding: 13px 30px;
      border-radius: 9px;
