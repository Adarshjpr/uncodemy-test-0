    .cta-box a:hover { transform: translateY(-2px); }

    footer {
      text-align: center;
      padding: 26px 20px 40px;
      font-size: 13px;
      color: var(--gray);
    }
    footer a { color: var(--orange); text-decoration: none; font-weight: 600; }

    @media (max-width: 640px) {
      .topbar { padding: 12px 16px; }
      .topbar img { height: 28px; }
      .btn-back { padding: 8px 14px; font-size: 13px; }
      h1.page-title { font-size: 25px; }
      .note-card { padding: 22px 16px; }
      .pagenav .next { text-align: left; }
    }
